# =========================================================================
# BevAdmin Pro Backend - .gitignore (Spring Boot 4 + Java 21 LTS + Maven)
# =========================================================================

# Maven Build Output
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Compiled Class Files & Packages
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# JVM Crash Logs
hs_err_pid*
replay_pid*

# Logs & Runtime Output
logs/
*.log
*.out

# Environment & Secret Configurations (Local overrides)
.env
.env.local
.env.*.local
application-local.yml
application-local.properties
application-secret.yml
application-secret.properties
*.pem
*.key
*.jks
*.p12

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

# Eclipse IDE
.apt_generated
.apt_generated_tests
.classpath
.factorypath
.project
.settings/
.springBeans

# NetBeans IDE
/nbproject/private/
/nbbuild/
/dist/
/nbproject/genfiles.properties
/nbproject/project.xml

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
