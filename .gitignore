# =========================================================================
# BevAdmin Pro Root - .gitignore (Monorepo / Multi-project)
# =========================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Environment variables & secrets
.env
.env.local
.env.*.local
.env.ops
ops/.env.ops
*.pem
*.key
ops/traefik/acme/

# Common IDEs & Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
*.sublime-project
*.sublime-workspace
.history/

# Log files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node / Frontend Artifacts
dev-frontend/node_modules/
dev-frontend/dist/
dev-frontend/.angular/
dev-frontend/coverage/

# Java / Maven / Backend & Auth Service Artifacts
dev-backend/target/
dev-backend/*.jar
dev-backend/*.war
dev-backend/hs_err_pid*
dev-backend/replay_pid*
dev-backend/application-local.yml
dev-backend/application-secret.yml

dev-auth-service/target/
dev-auth-service/*.jar
dev-auth-service/*.war
dev-auth-service/hs_err_pid*
dev-auth-service/replay_pid*
dev-auth-service/application-local.yml
dev-auth-service/application-secret.yml

# Docker & Container Data
docker-data/
*.pid
*.seed
*.pid.lock
# Local AI runtime state
.atl/
