# =========================================================================
# BevAdmin Pro - Variables de Entorno del Módulo Operativo (VPS Hardened)
# =========================================================================
# Copie este archivo a '.env.ops' para sobreescribir valores en producción:
#   cp ops/.env.ops.example ops/.env.ops
# =========================================================================

# 1. Configuración de Dominio y Certificados SSL Let's Encrypt
DOMAIN_NAME=bevadmin.com
ACME_EMAIL=admin@bevadmin.com

# 2. Credenciales para Respaldos Automatizados de PostgreSQL
DB_NAME=admin_dashboard_db
DB_USER=postgres
DB_PASSWORD=postgres

# 3. Canales de Notificación para Monitoreo Alert-on-Down (Uptime Kuma)
# (Configurables también desde la interfaz web en http://localhost:3001)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-1001234567890
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/token_aqui

# 4. Notificaciones y Gestión de Respaldos de Base de Datos (PostgreSQL Backup)
# URL Push Monitor en Uptime Kuma (ej: http://bevadmin-uptime-kuma:3001/api/push/CLAVE_AQUI)
BACKUP_PUSH_URL=
# Notificación directa a Telegram al culminar el backup
BACKUP_TELEGRAM_BOT_TOKEN=
BACKUP_TELEGRAM_CHAT_ID=
# Notificación directa a Discord (Webhook)
BACKUP_DISCORD_WEBHOOK_URL=
# Notificación a Webhook HTTP Genérico (JSON payload)
BACKUP_WEBHOOK_URL=
