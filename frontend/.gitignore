# =========================================================================
# BevAdmin Pro Frontend - .gitignore (Angular 19+ / TypeScript / SCSS)
# =========================================================================

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Dependencies
/node_modules
.pnpm-store

# Debug & Error logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Angular build cache & temporary files
/.angular
/.angular/cache
.sass-cache/

# Testing & Code Coverage
/coverage
testem.log
/typings
__screenshots__/
.nyc_output

# Linters and formatters cache
.eslintcache
.stylelintcache

# Environment variables & local secrets
.env
.env.local
.env.*.local
*.local

# Lock files & temp files
/connect.lock
/libpeerconnection.log

# IDEs and Editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
