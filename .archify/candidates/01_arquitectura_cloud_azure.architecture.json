  "cards": [
    {
      "dot": "cyan",
      "title": "Seguridad Perimetral y Zero-Trust",
      "items": [
        "Azure Front Door actúa como punto único de entrada global con WAF y reglas administradas OWASP Top 10.",
        "La base de datos PostgreSQL Flexible Server se despliega en una subred privada aislada accesible solo mediante Private Endpoint.",
        "Autenticación sin contraseñas (Passwordless) entre Backend y Key Vault mediante Managed Identity de Azure."
      ]
    },
    {
      "dot": "emerald",
      "title": "Cómputo Serverless y Escalabilidad",
      "items": [
        "Azure Container Apps (ACA) orquesta los contenedores Docker de Frontend y Backend sobre Kubernetes serverless.",
        "Escalamiento automático por demanda basado en solicitudes HTTP y concurrencia (KEDA).",
        "Alta disponibilidad multi-zona de PostgreSQL con failover transparente sin pérdida de datos (RPO = 0)."
      ]
    },
    {
      "dot": "amber",
      "title": "Pipeline CI/CD DevSecOps",
      "items": [
        "GitHub Actions ejecuta escaneos estáticos (SAST con SonarQube) y análisis de vulnerabilidades en imágenes con Trivy.",
        "Migraciones automáticas de esquema de base de datos con Flyway ejecutadas como Job de pre-despliegue.",
        "Despliegues sin tiempo de inactividad (Zero-Downtime Blue/Green) con reversión automática si fallan los healthchecks."
      ]
    }
  ]
